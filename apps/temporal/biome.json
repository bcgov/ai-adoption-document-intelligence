{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["../../biome.json"],
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/blob-storage-client"],
                "importNamePattern": "getBlobStorageClient",
                "message": "Access blob storage through getGroupBlobStorage(groupId) or readGroupBlob(key, groupId) so every key is checked against the run's group."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/blob-storage/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/jest.setup.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/test/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {
            "noRestrictedImports": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noEmptyBlockStatements": "off"
          },
          "security": {
            "noSecrets": "off"
          }
        }
      }
    }
  ]
}
