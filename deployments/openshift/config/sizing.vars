# Non-secret PLG monitoring sizing — same across all environments.
# Committed so values are visible in PRs and have change history.
# Sourced by the "Set infrastructure sizing" workflow step.
# PostgresCluster backup PVC sizes are prod-specific and live in
# deployments/openshift/kustomize/components/prod-resources/kustomization.yml.
LOKI_PVC_SIZE=2Gi
PROMETHEUS_PVC_SIZE=2Gi
LOKI_RETENTION_DAYS=30
METRICS_SCRAPE_INTERVAL=15s
